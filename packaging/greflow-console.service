[Unit]
Description=GreFlow management console
After=network-online.target
Wants=network-online.target

[Service]
User=greflow-console
Group=greflow-console
EnvironmentFile=-/etc/greflow-console/environment
ExecStart=/opt/greflow-console/greflow-console --data /var/lib/greflow-console --key-file /etc/greflow-console/master.key --listen 127.0.0.1:8787 --origin ${GREFLOW_ORIGIN}
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/greflow-console /etc/greflow-console

[Install]
WantedBy=multi-user.target
